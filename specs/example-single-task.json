{
    "apiVersion": "aether/v1",
    "kind": "Workflow",
    "metadata": {
        "name": "send-greeting",
        "annotations": {
            "description": "Minimal example: a single task that takes an input parameter and prints a greeting."
        }
    },
    "spec": {
        "entrypoint": "greet",
        "arguments": {
            "parameters": [
                {
                    "name": "username",
                    "type": "string",
                    "value": "Alice"
                }
            ]
        },
        "templates": [
            {
                "task": {
                    "name": "greet",
                    "inputs": {
                        "parameters": [
                            {
                                "name": "username",
                                "type": "string",
                                "valueFrom": {
                                    "parameter": "workflow.arguments.parameters.username"
                                }
                            }
                        ]
                    },
                    "executor": {
                        "type": "script",
                        "config": {
                            "runtime": "python3",
                            "source": "print(f'Hello, {{inputs.parameters.username}}!')"
                        }
                    },
                    "outputs": {
                        "parameters": [
                            {
                                "name": "message",
                                "type": "string",
                                "description": "The greeting message that was printed"
                            }
                        ]
                    }
                }
            }
        ]
    }
}
