{
    "apiVersion": "graph/v1",
    "kind": "Workflow",
    "metadata": {
        "name": "batch-process",
        "annotations": {
            "description": "Loop example: process a static list of files with concurrency=2."
        }
    },
    "spec": {
        "entrypoint": "run-loop",
        "templates": [
            {
                "loop": {
                    "name": "run-loop",
                    "items": ["report_jan.csv", "report_feb.csv", "report_mar.csv"],
                    "concurrency": 2,
                    "body": "process-file"
                }
            },
            {
                "task": {
                    "name": "process-file",
                    "inputs": {
                        "parameters": [
                            {
                                "name": "filename",
                                "type": "string"
                            }
                        ]
                    },
                    "executor": {
                        "type": "script",
                        "config": {
                            "runtime": "python3",
                            "source": "print(f'Processing [{inputs.parameters.loop_iter.index}] {inputs.parameters.loop_iter.item}')"
                        }
                    },
                    "outputs": {
                        "parameters": [
                            {
                                "name": "status",
                                "type": "string"
                            }
                        ]
                    }
                }
            }
        ]
    }
}
