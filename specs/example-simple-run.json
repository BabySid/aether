{
    "apiVersion": "aether/v1",
    "kind": "Workflow",
    "metadata": {
        "name": "simple-dag-demo",
        "annotations": {
            "description": "Self-contained demo workflow: three tasks in a DAG (fetch → process → notify)."
        }
    },
    "spec": {
        "entrypoint": "main-pipeline",
        "templates": [
            {
                "dag": {
                    "name": "main-pipeline",
                    "tasks": [
                        {
                            "name": "fetch",
                            "template": "fetch-data"
                        },
                        {
                            "name": "process",
                            "template": "process-data",
                            "dependencies": ["fetch"]
                        },
                        {
                            "name": "notify",
                            "template": "send-notification",
                            "dependencies": ["process"]
                        }
                    ]
                }
            },
            {
                "task": {
                    "name": "fetch-data",
                    "executor": {
                        "type": "function",
                        "config": {
                            "name": "noop"
                        }
                    }
                }
            },
            {
                "task": {
                    "name": "process-data",
                    "executor": {
                        "type": "function",
                        "config": {
                            "name": "noop"
                        }
                    }
                }
            },
            {
                "task": {
                    "name": "send-notification",
                    "executor": {
                        "type": "function",
                        "config": {
                            "name": "noop"
                        }
                    }
                }
            }
        ]
    }
}
