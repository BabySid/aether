{
    "apiVersion": "aether/v1",
    "kind": "Workflow",
    "metadata": {
        "name": "nested-dag",
        "annotations": {
            "description": "Nested DAG: outer DAG calls inner DAG template; inner outputs propagate to outer downstream task",
            "test:expect-phase": "Succeeded",
            "test:expect-task-count": "5"
        }
    },
    "spec": {
        "entrypoint": "outer",
        "templates": [
            {
                "dag": {
                    "name": "outer",
                    "tasks": [
                        {
                            "name": "sub",
                            "template": "inner-dag"
                        },
                        {
                            "name": "final",
                            "template": "finalize",
                            "dependencies": ["sub"],
                            "arguments": {
                                "parameters": [
                                    {
                                        "name": "result",
                                        "valueFrom": {"parameter": "tasks.sub.outputs.parameters.result"}
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "dag": {
                    "name": "inner-dag",
                    "tasks": [
                        {
                            "name": "step1",
                            "template": "inner-step-a"
                        },
                        {
                            "name": "step2",
                            "template": "inner-step-b",
                            "dependencies": ["step1"],
                            "arguments": {
                                "parameters": [
                                    {
                                        "name": "val",
                                        "valueFrom": {"parameter": "tasks.step1.outputs.parameters.val"}
                                    }
                                ]
                            }
                        }
                    ],
                    "outputs": {
                        "parameters": [
                            {
                                "name": "result",
                                "type": "object",
                                "valueFrom": {"parameter": "tasks.step2.outputs.parameters.result"}
                            }
                        ]
                    }
                }
            },
            {
                "task": {
                    "name": "inner-step-a",
                    "inputs": {
                        "parameters": [
                            {
                                "name": "outputs",
                                "value": [
                                    {"name": "val", "type": "int", "value": 42}
                                ]
                            }
                        ]
                    },
                    "executor": {"type": "echo"},
                    "outputs": {
                        "parameters": [{"name": "val", "type": "int"}]
                    }
                }
            },
            {
                "task": {
                    "name": "inner-step-b",
                    "inputs": {
                        "parameters": [
                            {"name": "val", "type": "int"},
                            {
                                "name": "outputs",
                                "value": [
                                    {"name": "result", "type": "object", "value": {"val": 42, "doubled": 84}}
                                ]
                            }
                        ]
                    },
                    "executor": {"type": "echo"},
                    "outputs": {
                        "parameters": [{"name": "result", "type": "object"}]
                    }
                }
            },
            {
                "task": {
                    "name": "finalize",
                    "inputs": {
                        "parameters": [
                            {"name": "result", "type": "object"},
                            {
                                "name": "outputs",
                                "value": [
                                    {"name": "done", "type": "bool", "value": true}
                                ]
                            }
                        ]
                    },
                    "executor": {"type": "echo"},
                    "outputs": {
                        "parameters": [{"name": "done", "type": "bool"}]
                    }
                }
            }
        ]
    }
}
