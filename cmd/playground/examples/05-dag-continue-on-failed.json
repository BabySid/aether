{
    "apiVersion": "aether/v1",
    "kind": "Workflow",
    "metadata": {
        "name": "dag-continue-on-failed",
        "annotations": {
            "description": "continueOn.failed on step-b: step-b fails, step-c still runs because step-b declares continueOn; DAG succeeds due to DAG-level continueOn",
            "test:expect-phase": "Succeeded",
            "test:expect-task-phase": "main=Succeeded,step-a=Succeeded,step-b=Failed,step-c=Succeeded"
        }
    },
    "spec": {
        "entrypoint": "main",
        "templates": [
            {
                "dag": {
                    "name": "main",
                    "continueOn": {"failed": true},
                    "tasks": [
                        {
                            "name": "step-a",
                            "template": "task-ok"
                        },
                        {
                            "name": "step-b",
                            "template": "task-fail",
                            "dependencies": ["step-a"],
                            "continueOn": {"failed": true}
                        },
                        {
                            "name": "step-c",
                            "template": "task-ok",
                            "dependencies": ["step-b"]
                        }
                    ]
                }
            },
            {
                "task": {
                    "name": "task-ok",
                    "executor": {
                        "type": "echo",
                        "config": {
                            "outputs": [
                                {"name": "status", "type": "string", "value": "ok"}
                            ]
                        }
                    },
                    "outputs": {
                        "parameters": [{"name": "status", "type": "string"}]
                    }
                }
            },
            {
                "task": {
                    "name": "task-fail",
                    "executor": {
                        "type": "echo",
                        "config": {
                            "failCount": 1
                        }
                    }
                }
            }
        ]
    }
}
