{
    "apiVersion": "aether/v1",
    "kind": "Workflow",
    "metadata": {
        "name": "dag-continue-on-failed",
        "annotations": {
            "description": "DAG continueOn.failed: step-b fails but DAG succeeds due to continueOn, step-c still runs",
            "test:expect-phase": "Succeeded",
            "test:expect-task-phase": "main=Succeeded,step-a=Succeeded,step-b=Failed,step-c=Succeeded"
        }
    },
    "spec": {
        "entrypoint": "main",
        "templates": [
            {
                "dag": {
                    "name": "main",
                    "continueOn": {"failed": true},
                    "tasks": [
                        {
                            "name": "step-a",
                            "template": "task-ok"
                        },
                        {
                            "name": "step-b",
                            "template": "task-fail",
                            "dependencies": ["step-a"]
                        },
                        {
                            "name": "step-c",
                            "template": "task-ok",
                            "dependencies": ["step-b"],
                            "continueOn": {"failed": true}
                        }
                    ]
                }
            },
            {
                "task": {
                    "name": "task-ok",
                    "executor": {
                        "type": "echo",
                        "config": {
                            "outputs": [
                                {"name": "status", "type": "string", "value": "ok"}
                            ]
                        }
                    },
                    "outputs": {
                        "parameters": [{"name": "status", "type": "string"}]
                    }
                }
            },
            {
                "task": {
                    "name": "task-fail",
                    "executor": {
                        "type": "echo",
                        "config": {
                            "outputs": [
                                {"name": "code",   "type": "int",    "value": 2},
                                {"name": "reason", "type": "string", "value": "intentional failure"}
                            ]
                        }
                    },
                    "outputs": {
                        "parameters": [
                            {"name": "code",   "type": "int"},
                            {"name": "reason", "type": "string"}
                        ]
                    }
                }
            }
        ]
    }
}
