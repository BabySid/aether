{
    "apiVersion": "aether/v1",
    "kind": "Workflow",
    "metadata": {
        "name": "dag-retry",
        "annotations": {
            "description": "Task-level retry: flaky-task fails on the first 2 attempts (failCount=2) then succeeds on the 3rd. retry.limit=3 + expression covers Failed phase.",
            "test:expect-phase": "Succeeded",
            "test:expect-task-phase": "main=Succeeded,flaky=Succeeded"
        }
    },
    "spec": {
        "entrypoint": "main",
        "templates": [
            {
                "dag": {
                    "name": "main",
                    "tasks": [
                        {
                            "name": "flaky",
                            "template": "flaky-task",
                            "retry": {
                                "limit": 3,
                                "expression": "tasks.flaky.phase != 'Succeeded'"
                            }
                        }
                    ]
                }
            },
            {
                "task": {
                    "name": "flaky-task",
                    "executor": {
                        "type": "echo",
                        "config": {
                            "failCount": 2,
                            "outputs": [
                                {"name": "status",  "type": "string", "value": "ok"},
                                {"name": "attempt", "type": "int",    "value": 3}
                            ]
                        }
                    },
                    "outputs": {
                        "parameters": [
                            {"name": "status",  "type": "string"},
                            {"name": "attempt", "type": "int"}
                        ]
                    }
                }
            }
        ]
    }
}
