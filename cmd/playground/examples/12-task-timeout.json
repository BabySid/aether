{
    "apiVersion": "aether/v1",
    "kind": "Workflow",
    "metadata": {
        "name": "task-timeout-demo"
    },
    "spec": {
        "entrypoint": "pipeline",
        "templates": [
            {
                "dag": {
                    "name": "pipeline",
                    "tasks": [
                        {
                            "name": "prepare",
                            "inputs": {
                                "parameters": [
                                    {
                                        "name": "outputs",
                                        "value": [
                                            {"name": "status", "type": "string", "value": "ready"}
                                        ]
                                    }
                                ]
                            },
                            "executor": {"type": "echo"}
                        },
                        {
                            "name": "wait-external",
                            "dependencies": ["prepare"],
                            "timeout": "1s",
                            "continueOn": {
                                "timeout": true
                            },
                            "inputs": {
                                "parameters": [
                                    {"name": "suspend", "value": true}
                                ]
                            },
                            "executor": {"type": "echo"}
                        },
                        {
                            "name": "finalize",
                            "dependencies": ["wait-external"],
                            "inputs": {
                                "parameters": [
                                    {
                                        "name": "outputs",
                                        "value": [
                                            {"name": "result", "type": "string", "value": "completed-after-timeout"}
                                        ]
                                    }
                                ]
                            },
                            "executor": {"type": "echo"}
                        }
                    ]
                }
            }
        ]
    }
}
